# ============================================================
# Prodigi Outbound Machine — Environment Configuration
# ============================================================
# Copy to .env and fill in values before running.
# All secrets must stay out of source control.

# --- Database ---
DATABASE_URL=postgresql://outbound:outbound@localhost:5432/outbound_machine
# For local SQLite (no Postgres required):
# DATABASE_URL=sqlite:///./outbound_machine.db

# --- HTTP Client ---
# User-agent string for outbound HTTP requests
HTTP_USER_AGENT=Mozilla/5.0 (compatible; ProdigiResearchBot/1.0; +https://prodigi.com)
# Seconds between requests to the same domain
RATE_LIMIT_DELAY=2.0
# Max concurrent requests
HTTP_CONCURRENCY=3
# Request timeout in seconds
HTTP_TIMEOUT=30
# Max retries on transient failure
HTTP_MAX_RETRIES=3

# --- Pipeline Feature Flags ---
# Enable Playwright screenshot capture (requires playwright install)
ENABLE_SCREENSHOTS=false
# Enable LLM-assisted personalisation polish
ENABLE_LLM=false
# Enable CRM webhook sync
ENABLE_WEBHOOK_SYNC=false

# --- LLM (optional) ---
# Provider: anthropic | openai
LLM_PROVIDER=anthropic
# anthropic
ANTHROPIC_API_KEY=
# openai (alternative)
OPENAI_API_KEY=
LLM_MODEL=claude-3-5-haiku-20241022
LLM_MAX_TOKENS=1024

# --- CRM Webhook (optional) ---
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_WEBHOOK_HEADERS={}

# --- Paths ---
SCREENSHOTS_DIR=./data/screenshots
EXPORTS_DIR=./data/exports
LOGS_DIR=./logs

# --- Scoring config path ---
SCORING_CONFIG_PATH=./app/config/scoring_config.yaml

# --- Logging ---
LOG_LEVEL=INFO
